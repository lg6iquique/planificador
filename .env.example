# ============================================================
# EJEMPLO DE CONFIGURACIÓN — COPIAR COMO .env
# ============================================================
# IMPORTANTE: Nunca subir el .env real al repositorio.
# Este archivo es una plantilla sin contraseñas reales.

# Motor de base de datos: 'sqlite' o 'postgres'
DB_ENGINE=sqlite

# ---- Configuración PostgreSQL (requerido cuando DB_ENGINE=postgres) ----
# PostgreSQL 17 — datos reales de producción — esquema 'traking'
DB_NAME=np_sis
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=traking

# ---- Notas de instalación local ----
# PostgreSQL 17 → puerto 5432 (sin contraseña)
# PostgreSQL 18 → puerto 5433 (contraseña: ver administrador)
# Base de datos: np_sis
# Esquema de tablas mct_*: traking
