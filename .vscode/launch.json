{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Django Server (F5)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver",
                "127.0.0.1:8000"
            ],
            "django": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Django Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "test"
            ],
            "django": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Inicializar BD (Seed)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "init_poc_db"
            ],
            "django": true,
            "console": "integratedTerminal"
        }
    ]
}
